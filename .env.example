# Copy to .env and adjust. Never commit .env.

# Postgres (inside Docker). The host port avoids clashing with a local Postgres on 5432.
POSTGRES_USER=lodestar
POSTGRES_PASSWORD=lodestar
POSTGRES_DB=lodestar
LODESTAR_PG_PORT=5442

LODESTAR_QDRANT_PORT=6333
LODESTAR_API_PORT=8000
LODESTAR_WEB_PORT=5173

# Local LLM. Default: the Ollama already running on the host. Containers can only reach it if it
# listens on all interfaces (OLLAMA_HOST=0.0.0.0 for the host's ollama service); otherwise use
# `make up-ollama` and http://ollama:11434, or run the backend outside Docker.
OLLAMA_URL=http://host.docker.internal:11434
LODESTAR_LOCAL_MODEL=qwen3.5:4b

# Encrypts users' API keys at rest (AGENTS.md rule 9). Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
LODESTAR_MASTER_KEY=

# Optional operator provider for background jobs (content pool filler). Leave empty to use Ollama.
LODESTAR_OPERATOR_LLM_PROVIDER=
LODESTAR_OPERATOR_LLM_KEY=
LODESTAR_OPERATOR_LLM_MODEL=
