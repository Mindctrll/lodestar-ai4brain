# Copy to .env and adjust. Never commit .env.

# Postgres (inside Docker). The host port avoids clashing with a local Postgres on 5432.
POSTGRES_USER=najma
POSTGRES_PASSWORD=najma
POSTGRES_DB=najma
NAJMA_PG_PORT=5442

NAJMA_QDRANT_PORT=6333
NAJMA_API_PORT=8000
NAJMA_WEB_PORT=5173

# Local LLM. Default: the Ollama already running on the host.
# With `make up-ollama`, use http://ollama:11434 instead.
OLLAMA_URL=http://host.docker.internal:11434
NAJMA_LOCAL_MODEL=qwen3.5:4b

# Encrypts users' API keys at rest (AGENTS.md rule 9). Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
NAJMA_MASTER_KEY=

# Optional operator provider for background jobs (content pool filler). Leave empty to use Ollama.
NAJMA_OPERATOR_LLM_PROVIDER=
NAJMA_OPERATOR_LLM_KEY=
NAJMA_OPERATOR_LLM_MODEL=
